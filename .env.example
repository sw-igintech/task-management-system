VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OPTIONAL — Cloudflare Worker API mode (migration). When VITE_USE_WORKER_API is exactly
# "true" AND VITE_WORKER_API_URL is set, the frontend reads/writes via the Worker API
# instead of talking to Supabase directly. Default (false/unset) = direct Supabase (or mock).
# The Worker URL is not a secret. Never put SUPABASE_SERVICE_ROLE_KEY in the frontend.
VITE_USE_WORKER_API=false
VITE_WORKER_API_URL=
# VITE_WORKER_API_URL=https://task-management-api.example.workers.dev

# OPTIONAL — local import script only. NEVER use in the frontend, never commit a real value.
# Only needed if Supabase RLS is tightened so the anon key can no longer delete/insert tasks.
# The import script (scripts/import_excel_tasks.ts) will prefer this key for the destructive
# delete+insert if it is set; otherwise it falls back to the anon key (current RLS allows it).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
