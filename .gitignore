# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Environment variables — never commit secrets
.env
.env.*
.env.local
.env.*.local
!.env.example
.mine

# Backups produced by the task import/sync scripts — never commit
backups/

# Sync/dry-run reports produced by scripts/sync_csv_tasks.ts — never commit
reports/

# Generated D1 export/import data — never commit (regenerate via scripts/d1/*)
exports/
*.sqlite
*.sqlite3

# Private task source exports / data files (internal engineering data) — kept out of
# version control. These are import sources; the data lives in the database after import.
# Broad rules for future safety (no such files are tracked today).
*.csv
*.xlsx
*.pdf
New Engineering Tasks*.csv
New Engineering Tasks*.xlsx
New Engineering Tasks*.pdf

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS junk
.DS_Store
Thumbs.db

# TypeScript build info
*.tsbuildinfo

# Wrangler local state (miniflare D1 / KV used for local validation only)
.wrangler/
