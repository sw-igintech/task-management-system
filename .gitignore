# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Environment variables — never commit secrets
.env
.env.local
.env.*.local

# Backups produced by the task import/sync scripts — never commit
backups/

# Sync/dry-run reports produced by scripts/sync_csv_tasks.ts — never commit
reports/

# Private task source exports (internal engineering data) — kept out of version control.
# These are the import source of truth; the data lives in Supabase after import.
New Engineering Tasks*.csv
New Engineering Tasks*.xlsx
New Engineering Tasks*.pdf

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS junk
.DS_Store
Thumbs.db

# TypeScript build info
*.tsbuildinfo
